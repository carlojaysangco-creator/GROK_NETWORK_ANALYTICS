# GROK Network Analytics – safe local defaults
# Copy to .env and adjust only if necessary.

NETWORK_ANALYTICS_HOST=127.0.0.1
NETWORK_ANALYTICS_PORT=8050
NETWORK_ANALYTICS_COLLECTION_ENABLED=false
NETWORK_ANALYTICS_LIVE_TOPOLOGY_ENABLED=false

# Optional target-owned roots (relative paths resolve under project root)
NETWORK_ANALYTICS_DATA_ROOT=data
NETWORK_ANALYTICS_RUNTIME_ROOT=runtime
NETWORK_ANALYTICS_ARTIFACT_ROOT=artifacts
NETWORK_ANALYTICS_LOG_ROOT=logs

# Secrets must never be placed in source control.
